{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["replicaCount", "image", "app", "service", "serviceAccount", "resources"],
  "properties": {
    "replicaCount": {"type": "integer", "minimum": 1},
    "image": {
      "type": "object",
      "required": ["repository", "digest", "pullPolicy"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "pullPolicy": {"type": "string", "enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "app": {
      "type": "object",
      "required": ["awsRegion", "dbHost", "dbSecretArn"],
      "properties": {
        "awsRegion": {"type": "string", "minLength": 1},
        "dbHost": {"type": "string", "minLength": 1},
        "dbSecretArn": {"type": "string", "minLength": 1}
      }
    },
    "serviceAccount": {
      "type": "object",
      "required": ["name"],
      "properties": {"name": {"type": "string", "minLength": 1}}
    },
    "service": {
      "type": "object",
      "required": ["type", "tls"],
      "properties": {
        "type": {"type": "string", "enum": ["ClusterIP", "LoadBalancer"]},
        "tls": {
          "type": "object",
          "required": ["enabled", "certificateArn"],
          "properties": {
            "enabled": {"type": "boolean"},
            "certificateArn": {"type": "string"}
          },
          "if": {"properties": {"enabled": {"const": true}}},
          "then": {"properties": {"certificateArn": {"pattern": "^arn:aws[a-z-]*:acm:[a-z0-9-]+:[0-9]{12}:certificate/[A-Za-z0-9-]+$"}}}
        }
      }
    },
    "resources": {"type": "object"}
  }
}
